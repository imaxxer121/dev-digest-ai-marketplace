{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "noUncheckedIndexedAccess": true, "allowJs": true, "checkJs": false,
    "allowImportingTsExtensions": true, "resolveJsonModule": true, "isolatedModules": true, "skipLibCheck": true, "noEmit": true
  },
  "include": ["src"]
}
